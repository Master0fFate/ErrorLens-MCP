{
  "name": "mcp-errorlens",
  "version": "0.2.0",
  "description": "Structured error recovery for MCP agents.",
  "type": "module",
  "mcpName": "io.github.master0ffate/errorlens",
  "homepage": "https://github.com/Master0fFate/ErrorLens-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Master0fFate/ErrorLens-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Master0fFate/ErrorLens-MCP/issues"
  },
  "bin": {
    "errorlens": "dist/cli/index.js",
    "mcp-errorlens": "dist/cli/index.js",
    "errorlens-companion": "dist/companion/diagnostic-server.js",
    "errorlens-proxy": "dist/proxy/proxy-server.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"for (const dir of ['dist', 'dist-tests']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"dist-tests/tests/*.test.js\"",
    "smoke": "node dist/qa/companion-smoke.js rate-limit && node dist/qa/companion-smoke.js rate-limit --transport http && node dist/qa/proxy-smoke.js write-timeout && node dist/qa/proxy-smoke.js publish-timeout && node dist/qa/proxy-smoke.js adapter-rule && node dist/qa/proxy-smoke.js write-timeout --transport http",
    "verify": "npm run lint && npm run build && npm test",
    "start:companion": "node dist/companion/diagnostic-server.js",
    "start:proxy": "node dist/proxy/proxy-server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-proxy",
    "streamable-http",
    "errors",
    "error-handling",
    "recovery",
    "retry-safety",
    "agents",
    "ai-agents",
    "observability",
    "local-first"
  ],
  "author": "Master0fFate",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
